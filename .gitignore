# =====================================
# 🔧 Node / React / Vite project ignores
# =====================================

# Dependency directories
node_modules/
jspm_packages/

# Build output
dist/
dist-ssr/
build/
.vite/

# Local environment files
.env
.env.local
.env.*.local

# Log files
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Cache
.cache/
.vscode/.react/
*.tsbuildinfo

# =====================================
# 💻 Editors & IDEs
# =====================================

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains (WebStorm, IntelliJ)
.idea/
*.iml

# Visual Studio (caso alguém use para front)
*.suo
*.ntvs*
*.njsproj
*.sln

# Sublime / Others
*.sublime-workspace
*.sublime-project

# =====================================
# 🧠 OS-specific files
# =====================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# =====================================
# 🧩 Misc
# =====================================

# Optional npm/yarn/pnpm logs and local settings
.npmrc
.yarnrc
.pnpm-debug.log*

# Local test coverage / reports
coverage/
*.lcov
